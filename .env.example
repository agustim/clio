# Database
DATABASE_URL=sqlite://data/linkanalyzer.db

# Server
BIND_ADDR=127.0.0.1:8080

# LLM (Optional). Si LLM_PROVIDER buit o "none" o no s'arriba a l'endpoint => fallback extractiu.
# vllm/openai/ollama exposen API compatible OpenAI a /v1/chat/completions.
LLM_PROVIDER=vllm
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
# Timeout per crida al LLM (segons). Models grans triguen molt generant; puja si veus
# "error sending request" al deep pass. Per defecte 120.
LLM_TIMEOUT_SECS=120

# Embeddings (independents del LLM de chat). Habiliten el ranking personalitzat
# per "cors" a la web. Backfill dels links existents: `linkanalyzer reindex`.
#
# EMBED_PROVIDER:
#   local   -> in-process via fastembed (cap servei extern; descarrega el model
#              el primer cop i després offline). Requereix feature 'local-embed'.
#   openai  -> API d'OpenAI (EMBED_MODEL=text-embedding-3-small, EMBED_DIM honora dimensions).
#   ollama/vllm/http -> qualsevol endpoint OpenAI-compatible (/embeddings).
#   (buit)  -> reusa LLM_PROVIDER.
#
# EMBED_BASE_URL / EMBED_API_KEY: si es deixen buits, es reusen els de LLM_*.
# En mode local, EMBED_MODEL és l'id de fastembed (p.ex. multilingual-e5-small,
# bge-m3, nomic-embed-text) i EMBED_BASE_URL/DIM s'ignoren.
EMBED_PROVIDER=local
EMBED_MODEL=multilingual-e5-small
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=256

# Git repo per a la web estàtica (push opt-in: nomes si WEB_REPO_URL definit)
WEB_REPO_URL=
WEB_BRANCH=main
GIT_TOKEN=

# Telegram: el bot accepta links d'usuaris amb telegram_id i respon "Processant url.".
TELEGRAM_BOT_TOKEN=
# Chat on el bot envia avisos d'admin (arrencada + errors d'anàlisi). Buit = cap
# avís. El teu id numèric el dóna @userinfobot; els grups tenen id negatiu.
ADMIN_CHAT_ID=

# Sortida web
PUBLIC_DIR=public

# Limits
MAX_LINK_SIZE_MB=5
SUMMARY_MAX_WORDS=300
SUMMARY_MAX_CHARS=150
# UA de navegador real per defecte; molts murs bloquegen UA de bot.
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Pàgines protegides (Cloudflare & co.): fallback via FlareSolverr en 403/429/503.
# Buit = desactivat. El docker-compose ja inclou el servei `flaresolverr`.
FLARESOLVERR_URL=http://flaresolverr:8191
FLARESOLVERR_TIMEOUT_SECS=60

# Cua d'anàlisi async
QUEUE_WORKERS=4

# Regeneració periòdica de la web durant `serve` (segons). 0 = desactiva.
# Posa 0 si uses el deploy reactiu (recomanat): la web es regenera i fa push
# només quan s'acaba d'analitzar un link nou.
WEB_REGEN_SECS=0

# Deploy reactiu: finestra (segons) per agrupar una ràfega de links nous en
# un sol push/deploy després que la cua acabi d'analitzar.
WEB_DEBOUNCE_SECS=60

# Categories de fonts per a la web estàtica. Format: nom=font1,font2;nom2=font3
# WEB_DEFAULT_CATEGORY: categoria seguida per defecte pels visitants nous
# (buida = totes les fonts).
WEB_CATEGORIES=
WEB_DEFAULT_CATEGORY=

# Segona passada (deep): clone de repos
CLONE_TIMEOUT_SECS=120
CLONE_MAX_MB=200

# Cloudflare Tunnel (docker-compose.yml). Token del tunnel creat a
# Zero Trust > Networks > Tunnels. Public Hostname -> http://clio:8080.
TUNNEL_TOKEN=

# ---- Overlay de directe (Twitch i/o YouTube & co.) ----
# Servit pel mateix `clio serve`: /overlay (escena HTML) + /overlay/ticker.json (dades).
OVERLAY_REFRESH_SECS=60   # cada quants segons es re-carrega el ticker
OVERLAY_ROTATE_SECS=12    # cada quants segons canvia la graella de cards
OVERLAY_MAX_ITEMS=50      # quantes notícies entren al ticker/crawl
OVERLAY_CARDS=4           # quantes cards visibles; la rotació salta de CARDS en CARDS
OVERLAY_TEXT_LINES=9      # línies de text LLM visibles per card (triplicat per defecte)
# TimeZone (IANA) per a les hores/data de les notícies i el rellotge de l'escena.
# Buit = hora local del navegador que emet el stream. Exemples: Europe/Andorra,
# Europe/Madrid, America/New_York, UTC.
OVERLAY_TIMEZONE=Europe/Andorra
# Finestra (minuts) per marcar una notícia com a NOVA (marc vermell + cintó ● NOU).
# 0 = desactiva la marca.
OVERLAY_NEW_MINUTES=30
# Carpeta on es desen LOCALMENT les imatges baixades en analitzar la cua
# (l'overlay les serveix a /imgout/{id}; si no n'hi ha, cau al proxy /img).
IMAGES_DIR=data/images

# ---- Emissió headless (sense OBS): docker-compose.stream.yml ----
# Imatge "tot en un" (target stream del mateix Dockerfile) amb CLIO_MODE=stream.
# Cal com a mínim UNA clau (Twitch, YouTube o totes dues).
# STREAM_MODE determina com s'emet a les plataformes amb clau:
#   tee   (per defecte) UNA sola codificació per a totes (muxer `tee` d'ffmpeg):
#         no es codifica mai el vídeo dues vegades -> estalvia CPU/GPU. Si una
#         plataforma cau a mig directe, un watcher reinicia el flux per
#         re-conectar-la; si ja era avall en arrencar s'hi torna cada
#         TEE_RETRY_SECS sense fer flap.
#   split Una per cada plataforma en el seu propi ffmpeg (més aïllament entre
#         caigudes, però codifica el DOBLE en mode software).
# TEE_WARMUP_SECS: mode tee, segons abans d'actuar sobre un "slave failed"
#         (per defecte 20; una fallada dins aquesta finestra = "ja era avall").
# TEE_RETRY_SECS: mode tee, cada quants segons es re-prova una plataforma que
#         està avall (per defecte 300).
STREAM_MODE=tee
TEE_WARMUP_SECS=20
TEE_RETRY_SECS=300
# Twitch: clau del teu canal a https://dashboard.twitch.tv > Configuració > Flux.
TWITCH_STREAM_KEY=
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
# YouTube: a YouTube Studio > "Crea" > "Emet en directe" crea un directe i
# copia la seva clau d'emissió (sense un directe actiu l'ingest la rebutja o el
# canal no mostra res). L'URL per defecte és l'ingest estàndard; si vols la
# versió xifrada posa rtmps://a.rtmp.youtube.com/live2.
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# Mida/fps de l'escena capturada. IMPORTANT: el Chromium kiosk força la finestra
# a 1920x1080; si l'escena fos més petita el contingut es retallaria i es veuria
# encongit. Per tant emetem a 1080p (recomanat: 1920x1080@30 amb ~5000k).
OVERLAY_WIDTH=1920
OVERLAY_HEIGHT=1080
OVERLAY_FPS=30

# ---- Veu dels titulars + música de fons (TTS Edge, pur Rust) ----
# En analitzar la cua, cada notícia "noticiosa" genera un MP3 llegint el seu
# títol en català (veus Edge "Read Aloud", transformades a to + velocitat amb
# el crate `clio-voice`; cap dependència ffmpeg). L'overlay els llegeix en
# directe dins del grup de cards visible. Backfill dels existents:
#   linkanalyzer voice --limit 100
# Nota: el servei Edge rota el seu token de tant en tant; si veus 403 a la
# sintesi, actualitza la versió d'Edge a voice/src/edge.rs.
TTS_ENABLED=0               # 1 = genera els MP3 (requereix sortida a Internet)
TTS_VOICE=ca-ES-JoanaNeural # veu de sintesi (ca-ES-AlbaNeural és l'altra opció)
TTS_LANG=ca-ES
TTS_RATE_FACTOR=0.75        # to: x0.75 (~3 semitons més greu)
TTS_TEMPO=2.0               # velocitat: el doble (dura la meitat)
TTS_TARGET_RATE=24000       # kHz de sortida del transform
TTS_KBPS=48                 # bitrate del MP3 final
TTS_DIR=data/tts            # carpeta on es desen els MP3 (servits a /audio/{id})
TTS_TIMEOUT_SECS=20         # timeout per la sintesi d'un titular
TTS_ONLY_NEWS=1             # 0 = genera veu per a TOTS els tipus de link
# Música de fons de l'escena: un MP3 lliure de drets a PUBLIC_DIR/music.mp3. A
# cada arrencada serve hi copia el bucle per defecte d'assets/music.mp3 (pista
# "Ambient B" de FreePD, domini públic) si no n'hi ha cap; substitueix el fitxer
# per canviar-la. Volum normal i volum mentre es llegeixen titulars (ducking; 0.0-1.0).
OVERLAY_MUSIC_VOLUME=0.22
OVERLAY_MUSIC_DUCK=0.07
# Pausa (ms) entre la lectura d'un titular i el següent dins el mateix grup.
OVERLAY_READ_GAP_MS=500
