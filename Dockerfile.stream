# Overlay -> Twitch sense OBS: Xvfb + Chromium + ffmpeg a sobre de la imatge
# de Clio. Només s'usa per al servei `stream` de docker-compose.stream.yml.
FROM ghcr.io/agustim/clio:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb xdotool chromium ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/stream.sh /usr/local/bin/stream.sh
RUN chmod +x /usr/local/bin/stream.sh

ENV OVERLAY_URL=http://127.0.0.1:8080/overlay
CMD ["stream.sh"]
